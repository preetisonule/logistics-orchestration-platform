generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WarehouseTask {
  id            String   @id @default(uuid())
  sourceEventId String?  @unique
  correlationId String?
  inventoryId   String?
  productId     String
  warehouseId   String
  quantity      Int
  weightKg      Float    @default(1)
  serviceLevel  String   @default("STANDARD")
    automationMode String  @default("MANUAL")
  status        String   @default("PICKING_PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     String
  published   Boolean   @default(false)
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
}