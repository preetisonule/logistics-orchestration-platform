generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WarehouseTask {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  quantity    Int
  status      String   @default("PICKING_PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}